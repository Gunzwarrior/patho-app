# Current production LXC deployment. BACKUP_DIR is a mount backed on the host
# by /mnt/storage/work/anapath/pathopilot-backups, outside the LXC filesystem.
PATHOPILOT_APP_DIR=/root/patho-app
PATHOPILOT_BACKUP_SOURCE_DB=/root/patho-app/pathology.db
PATHOPILOT_BACKUP_DIR=/mnt/pathopilot-backups

# 288 ten-minute backups cover 48 hours; then retain 14 daily snapshots.
PATHOPILOT_BACKUP_FREQUENT_RETENTION=288
PATHOPILOT_BACKUP_DAILY_RETENTION=14
